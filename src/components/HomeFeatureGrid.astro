---
import { Icon } from '@astrojs/starlight/components';

const features = [
	{
		title: 'Bases financières',
		description:
			'Définir ses objectifs, comprendre le risque et organiser une épargne régulière.',
		href: '/epargne/bases-financieres/definir-ses-objectifs/',
		icon: 'open-book',
	},
	{
		title: 'Études académiques',
		description:
			'Relier les grands travaux financiers aux choix concrets de diversification et de gestion passive.',
		href: '/epargne/etudes-academiques/diversification-et-frontiere-efficiente/',
		icon: 'analytics',
	},
	{
		title: 'Planification retraite',
		description:
			'Estimer son besoin futur et adapter son allocation à mesure que l’horizon de retraite approche.',
		href: '/epargne/planification-retraite/estimer-son-besoin/',
		icon: 'clock',
	},
	{
		title: 'Produits disponibles',
		description:
			'Situer les livrets, fonds euros, actions, obligations, ETF et produits plus complexes.',
		href: '/epargne/produits-disponibles/livrets-et-fonds-euros/',
		icon: 'database',
	},
	{
		title: "Enveloppes d'investissement",
		description:
			'Comparer les cadres d’investissement comme le CTO, le PEA, l’assurance-vie et le PER.',
		href: '/epargne/enveloppes-investissement/compte-titres-ordinaire/',
		icon: 'document',
	},
	{
		title: 'Épargne salariale',
		description:
			'Comprendre la participation, l’intéressement, l’abondement et les plans disponibles chez AREP.',
		href: '/epargne/epargne-salariale/participation-interessement-abondement/',
		icon: 'star',
	},
] as const;
---

<script is:inline>
	document.documentElement.classList.add('home-motion-enabled');
</script>

<section class="home-features" aria-labelledby="home-features-title">
	<h2 id="home-features-title" data-home-reveal data-home-heading>Explorer les contenus</h2>
	<div class="feature-grid" data-home-card-group>
		{
			features.map((feature) => (
				<a
					class="feature-card"
					href={feature.href}
					data-home-reveal
					data-home-card
				>
					<span class="feature-icon" aria-hidden="true">
						<Icon name={feature.icon} size="1.7rem" />
					</span>
					<span class="feature-title">{feature.title}</span>
					<span class="feature-description">{feature.description}</span>
					<span class="feature-cta">
						Lire la page
						<Icon name="right-arrow" size="1rem" class="feature-arrow rtl:flip" />
					</span>
				</a>
			))
		}
	</div>
</section>

<script>
	const revealItems = document.querySelectorAll<HTMLElement>('[data-home-reveal]');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!reducedMotion && 'IntersectionObserver' in window) {
		const createRevealObserver = (rootMargin: string) =>
			new IntersectionObserver(
				(entries, observer) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				},
				{ rootMargin, threshold: 0.18 }
			);

		const headingObserver = createRevealObserver('0px 0px -14% 0px');
		const cardObserver = new IntersectionObserver(
			(entries, observer) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					for (const card of entry.target.querySelectorAll<HTMLElement>('[data-home-card]')) {
						card.classList.add('is-visible');
					}
					observer.unobserve(entry.target);
				}
			},
			{ rootMargin: '0px 0px -28% 0px', threshold: 0.12 }
		);

		for (const item of document.querySelectorAll<HTMLElement>('[data-home-heading]')) {
			headingObserver.observe(item);
		}

		for (const group of document.querySelectorAll<HTMLElement>('[data-home-card-group]')) {
			cardObserver.observe(group);
		}
	} else {
		for (const item of revealItems) {
			item.classList.add('is-visible');
		}
	}
</script>

<style>
	.home-features {
		margin-block: clamp(3rem, 8vh, 6rem) 4rem;
	}

	.home-features h2 {
		margin: 0;
		color: var(--sl-color-white);
		font-size: 2.35rem;
		font-weight: 700;
		letter-spacing: 0;
		line-height: 1.1;
		text-align: center;
	}

	:global(.home-motion-enabled) .home-features [data-home-reveal] {
		opacity: 0;
		translate: 0 4.5rem;
	}

	:global(.home-motion-enabled) .home-features [data-home-reveal].is-visible {
		animation: home-feature-rise 1950ms cubic-bezier(0.16, 1, 0.3, 1) both;
		animation-delay: var(--feature-delay, 0ms);
	}

	@keyframes home-feature-rise {
		from {
			opacity: 0;
			translate: 0 4.5rem;
		}

		to {
			opacity: 1;
			translate: 0 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.home-motion-enabled) .home-features [data-home-reveal] {
			opacity: 1;
			translate: none;
			animation: none;
		}
	}

	.feature-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		margin-top: 2rem;
	}

	.feature-card {
		position: relative;
		display: flex;
		min-height: 17rem;
		flex-direction: column;
		gap: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: color-mix(in srgb, var(--sl-color-black) 86%, var(--sl-color-gray-6));
		padding: 1.6rem;
		box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 16%);
		text-decoration: none;
		transition:
			border-color 160ms ease,
			box-shadow 160ms ease,
			transform 160ms ease;
	}

	.feature-card:hover,
	.feature-card:focus-visible {
		border-color: var(--sl-color-gray-3);
		box-shadow: 0 1.2rem 3rem rgb(0 0 0 / 22%);
		transform: translateY(-0.125rem);
	}

	.feature-card:focus-visible {
		outline: 2px solid var(--sl-color-accent-high);
		outline-offset: 3px;
	}

	.feature-icon {
		display: inline-flex;
		width: 3.9rem;
		height: 3.9rem;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.45rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
	}

	.feature-title {
		margin-top: 0.55rem;
		color: var(--sl-color-white);
		font-size: 1.35rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.feature-description {
		color: var(--sl-color-gray-2);
		font-size: 1rem;
		line-height: 1.65;
	}

	.feature-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin-top: auto;
		color: var(--sl-color-accent-high);
		font-size: 0.95rem;
		font-weight: 700;
	}

	.feature-arrow {
		transition: transform 160ms ease;
	}

	.feature-card:hover .feature-arrow,
	.feature-card:focus-visible .feature-arrow {
		transform: translateX(0.15rem);
	}

	@media (min-width: 48rem) {
		.home-features h2 {
			font-size: 3rem;
		}

		.feature-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.25rem;
			margin-top: 2.6rem;
		}

		.feature-card {
			padding: 1.9rem;
		}
	}
</style>
