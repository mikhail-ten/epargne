---
import { Icon } from '@astrojs/starlight/components';

const features = [
	{
		title: 'Théorie du portefeuille',
		description:
			'Comprendre les principes de diversification et de construction de portefeuille avant de choisir ses supports.',
		href: '/epargne/guides/theorie-moderne-de-portefeille/',
		icon: 'open-book',
	},
	{
		title: 'Guides pratiques',
		description:
			'Avancer pas à pas avec des contenus orientés action pour mieux organiser son épargne.',
		href: '/epargne/guides/example/',
		icon: 'pencil',
	},
	{
		title: 'Références',
		description:
			'Retrouver les notions clés sous une forme concise pour comparer, vérifier et décider plus sereinement.',
		href: '/epargne/reference/example/',
		icon: 'document',
	},
] as const;
---

<section class="home-features" aria-labelledby="home-features-title">
	<h2 id="home-features-title">Explorer les contenus</h2>
	<div class="feature-grid">
		{
			features.map((feature) => (
				<a class="feature-card" href={feature.href}>
					<span class="feature-icon" aria-hidden="true">
						<Icon name={feature.icon} size="1.7rem" />
					</span>
					<span class="feature-title">{feature.title}</span>
					<span class="feature-description">{feature.description}</span>
					<span class="feature-cta">
						Lire la page
						<Icon name="right-arrow" size="1rem" class="feature-arrow rtl:flip" />
					</span>
				</a>
			))
		}
	</div>
</section>

<style>
	.home-features {
		margin-block: 1rem 4rem;
	}

	.home-features h2 {
		margin: 0;
		color: var(--sl-color-white);
		font-size: 2.35rem;
		font-weight: 700;
		letter-spacing: 0;
		line-height: 1.1;
		text-align: center;
	}

	.feature-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		margin-top: 2rem;
	}

	.feature-card {
		position: relative;
		display: flex;
		min-height: 17rem;
		flex-direction: column;
		gap: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: color-mix(in srgb, var(--sl-color-black) 86%, var(--sl-color-gray-6));
		padding: 1.6rem;
		box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 16%);
		text-decoration: none;
		transition:
			border-color 160ms ease,
			box-shadow 160ms ease,
			transform 160ms ease;
	}

	.feature-card:hover,
	.feature-card:focus-visible {
		border-color: var(--sl-color-gray-3);
		box-shadow: 0 1.2rem 3rem rgb(0 0 0 / 22%);
		transform: translateY(-0.125rem);
	}

	.feature-card:focus-visible {
		outline: 2px solid var(--sl-color-accent-high);
		outline-offset: 3px;
	}

	.feature-icon {
		display: inline-flex;
		width: 3.9rem;
		height: 3.9rem;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.45rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
	}

	.feature-title {
		margin-top: 0.55rem;
		color: var(--sl-color-white);
		font-size: 1.35rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.feature-description {
		color: var(--sl-color-gray-2);
		font-size: 1rem;
		line-height: 1.65;
	}

	.feature-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin-top: auto;
		color: var(--sl-color-accent-high);
		font-size: 0.95rem;
		font-weight: 700;
	}

	.feature-arrow {
		transition: transform 160ms ease;
	}

	.feature-card:hover .feature-arrow,
	.feature-card:focus-visible .feature-arrow {
		transform: translateX(0.15rem);
	}

	@media (min-width: 48rem) {
		.home-features h2 {
			font-size: 3rem;
		}

		.feature-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.25rem;
			margin-top: 2.6rem;
		}

		.feature-card {
			padding: 1.9rem;
		}
	}
</style>
