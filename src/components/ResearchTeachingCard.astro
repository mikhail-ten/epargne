---
interface Props {
	paper: string;
	authors: string;
	imageSrc?: string;
	imageAlt?: string;
	label?: string;
}

const {
	paper,
	authors,
	imageSrc,
	imageAlt = '',
	label = 'Enseignement',
} = Astro.props;

const hasImage = Boolean(imageSrc);
---

<aside class:list={['research-teaching-card', { 'has-image': hasImage }]}>
	<div class="research-teaching-copy">
		<p class="research-teaching-label">{label}</p>
		<div class="research-teaching-text">
			<slot />
		</div>
		<p class="research-teaching-source">
			<span>{paper}</span>
			<span aria-hidden="true"> - </span>
			{authors}
		</p>
	</div>

	{
		hasImage && (
			<figure class="research-teaching-image">
				<img src={imageSrc} alt={imageAlt} loading="lazy" decoding="async" />
			</figure>
		)
	}
</aside>

<style>
	.research-teaching-card {
		--research-card-bg: #cad3dd;
		--research-card-border: #aeb9c4;
		--research-card-ink: var(--brand-text, #262626);
		--research-card-muted: #4f5963;
		--research-card-accent: var(--brand-red, #d71b1b);
		--research-card-kicker: var(--brand-teal, #1a515d);

		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(1.2rem, 3vw, 2rem);
		margin-block: 1.5rem;
		border: 1px solid var(--research-card-border);
		border-radius: 0.5rem;
		background: var(--research-card-bg);
		padding: clamp(1.35rem, 3vw, 2rem);
		padding-inline-start: clamp(1.6rem, 3vw, 2.3rem);
		box-shadow: 0 0.8rem 2rem rgb(0 0 0 / 6%);
		color: var(--research-card-ink);
	}

	.research-teaching-card::before {
		position: absolute;
		inset-block: 0;
		inset-inline-start: 0;
		width: 0.28rem;
		border-radius: 0.5rem 0 0 0.5rem;
		background: var(--research-card-accent);
		content: '';
	}

	.research-teaching-copy {
		display: grid;
		min-width: 0;
		gap: 1rem;
	}

	.research-teaching-label,
	.research-teaching-source,
	.research-teaching-image {
		margin: 0;
	}

	.research-teaching-label {
		color: var(--research-card-kicker);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.research-teaching-text {
		font-size: clamp(1.05rem, 1.2vw, 1.28rem);
		line-height: 1.55;
		text-wrap: pretty;
	}

	.research-teaching-text :global(p) {
		margin: 0;
	}

	.research-teaching-text :global(p + p) {
		margin-top: 0.8rem;
	}

	.research-teaching-source {
		border-top: 1px solid color-mix(in srgb, var(--research-card-border) 82%, #ffffff);
		padding-top: 0.9rem;
		color: var(--research-card-muted);
		font-size: 0.86rem;
		line-height: 1.45;
	}

	.research-teaching-source span:first-child {
		color: var(--research-card-ink);
		font-weight: 700;
	}

	.research-teaching-image {
		position: relative;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--research-card-border) 78%, #ffffff);
		border-radius: 0.45rem;
		background: rgb(255 255 255 / 42%);
		aspect-ratio: 16 / 10;
	}

	.research-teaching-image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (min-width: 44rem) {
		.research-teaching-card.has-image {
			grid-template-columns: minmax(0, 1fr) minmax(12rem, 32%);
			align-items: stretch;
		}

		.research-teaching-card.has-image .research-teaching-image {
			aspect-ratio: auto;
		}

		.research-teaching-card.has-image .research-teaching-image img {
			position: absolute;
			inset: 0;
		}
	}
</style>
